# ============================================================
# DATA POLICY (see data/README.md for the full detail)
# ------------------------------------------------------------
# Raw datasets are NEVER committed. Processed artefacts that
# contain email body text are also excluded, because they still
# hold redacted email content (and residual free-text PII until
# the Presidio pass is complete). Only purely NUMERICAL artefacts
# (URL features, scaler, schema) and JSON readiness reports are
# version-controlled.
# ============================================================

# --- Raw data: never commit ---
data/raw/*
!data/raw/.gitkeep

# --- Text-bearing processed artefacts: contain redacted email content ---
*semantic_corpus*.csv
*joint_eval*_text.parquet
data/processed/*text*
data/processed/*semantic*

# LSTM character-sequence data (large, regenerable from the corpus)
*.npy
data/processed/G2_v2/lstm_data

# --- Trained model weights / checkpoints: excluded (dual-use, size) ---
*.pt
*.pth
*.h5
*.ckpt
*.safetensors
models/checkpoints/
results/checkpoints/

# --- Large regenerable feature data (optional: keep history lean) ---
# Uncomment to also exclude the larger URL-feature parquets if size grows.
# data/processed/url_features_*.parquet

# ============================================================
# Standard Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Secrets / credentials (never commit) ---
.env
*.key
credentials.json
secrets.*
